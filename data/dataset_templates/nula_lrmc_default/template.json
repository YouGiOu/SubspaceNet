{
  "description": "Baseline NULA + LRMC + SubspaceNet dataset template using [0,1,4,8] on a 0.5 lambda grid.",
  "scenario_data_path": "nula_lrmc_subspacenet",
  "commands": {
    "SAVE_TO_FILE": false,
    "CREATE_DATA": true,
    "LOAD_DATA": false,
    "LOAD_MODEL": false,
    "TRAIN_MODEL": true,
    "SAVE_MODEL": false,
    "EVALUATE_MODE": true
  },
  "system_model": {
    "N": 4,
    "M": 2,
    "T": 200,
    "snr": 10,
    "signal_type": "NarrowBand",
    "signal_nature": "non-coherent",
    "eta": 0,
    "bias": 0,
    "sv_noise_var": 0,
    "array_spacing": 0.5,
    "doa_min": -90.0,
    "doa_max": 90.0,
    "doa_resolution": 0.01,
    "min_doa_gap": 15.0,
    "sensor_positions": [
      0,
      1,
      4,
      8
    ],
    "virtual_array_size": 9,
    "lrmc_rank": 3,
    "use_lrmc": true,
    "lrmc_solver": "svd"
  },
  "model": {
    "model_type": "SubspaceNet",
    "diff_method": "esprit",
    "tau": 8
  },
  "dataset": {
    "samples_size": 4096,
    "train_test_ratio": 0.2
  },
  "training": {
    "batch_size": 64,
    "epochs": 200,
    "learning_rate": 5e-06,
    "weight_decay": 1e-09,
    "scheduler_step_size": 120,
    "scheduler_gamma": 0.2
  },
  "evaluation": {
    "disable_augmented_methods": true,
    "disable_subspace_methods": true
  }
}


