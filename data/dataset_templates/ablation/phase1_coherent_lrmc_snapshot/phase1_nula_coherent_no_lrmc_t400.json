{
  "experiment_type": "subspace",
  "methods": [
    "music",
    "esprit",
    "r-music"
  ],
  "seed": 42,
  "commands": {
    "CREATE_DATA": true,
    "LOAD_DATA": false,
    "TRAIN_MODEL": false,
    "EVALUATE_MODE": true
